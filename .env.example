# ─── Notifications Microservice ───────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# MongoDB (obligatoria en producción)
MONGO_URI=mongodb://mongo-notifications:27017/notifications

# API Key backend -> microservicio (/send, /send-bulk, /broadcast).
# Generar: openssl rand -hex 32   (no puede ser "changeme...")
API_KEY=

# Secreto con el que el BACKEND PHP firma el token de notificaciones (HS256).
# Debe ser igual a NOTIFICATIONS_JWT_SECRET del .env del backend, pero DISTINTO de SEC_KEY y de API_KEY.
# Generar: openssl rand -hex 32   (mínimo 32 caracteres)
NOTIFICATIONS_JWT_SECRET=

# Opcionales: deben coincidir con los del backend (valores por defecto abajo)
# NOTIFICATIONS_JWT_ISSUER=it-backend
# NOTIFICATIONS_JWT_AUDIENCE=it-notifications

# Orígenes permitidos para CORS y WebSocket, separados por coma (obligatoria en producción)
# Producción: https://crm.itwebservices.net
CORS_ORIGINS=http://localhost:5173,http://localhost:80
