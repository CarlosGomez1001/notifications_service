# ─── Notifications Microservice ───────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://mongo-notifications:27017/notifications

# API Key para autenticación backend-a-microservicio (generar una clave segura)
API_KEY=changeme-generate-a-secure-key

# Orígenes permitidos para CORS y WebSocket (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:80
